# Database
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/complaint_db?retryWrites=true&w=majority

# Server
PORT=5000
NODE_ENV=production

# Client URL (Vercel frontend URL)
CLIENT_URL=https://your-frontend.vercel.app
# Optional additional allowed origins (comma separated)
CLIENT_URLS=https://your-frontend.vercel.app,https://your-preview.vercel.app
# Allow Vercel preview domains (*.vercel.app). Default auto-enables when CLIENT_URL is on vercel.app
ALLOW_VERCEL_PREVIEWS=true

# JWT Secret
JWT_SECRET=your-secret-key-here-change-this-in-production

# Groq API (for AI features)
GROQ_API_KEY=your-groq-api-key
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_TIMEOUT_MS=20000

# Gemini API (optional)
GEMINI_API_KEY=your-gemini-api-key

# Admin Email (for notifications)
ADMIN_EMAIL=admin@example.com
